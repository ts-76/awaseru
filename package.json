{
  "name": "scheduling",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "postinstall": "void prepare",
    "typecheck": "void prepare && tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "vp test run --config vitest.config.ts",
    "db:migrate:local": "void db migrate",
    "secretlint": "secretlint \"**/*\"",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "void deploy --platform cloudflare",
    "test:integration": "node scripts/integration.mjs",
    "template:generate": "node scripts/generate-cloudflare-template.mjs",
    "template:check": "node scripts/generate-cloudflare-template.mjs --check",
    "template:verify": "node scripts/verify-cloudflare-template.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "^4.11.9",
    "jose": "6.2.13",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@void/react": "1.2.1",
    "oxc-transform-react": "^0.149.0",
    "secretlint": "13.0.7",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0",
    "void": "1.2.1",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@cloudflare/config": {
      "zod": "$zod"
    },
    "esbuild": "^0.28.2",
    "undici": "^7.30.1",
    "vite": "$vite"
  }
}
