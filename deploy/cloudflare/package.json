{
  "name": "scheduling",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "cd app && void prepare",
    "build": "node build.mjs",
    "deploy": "wrangler d1 migrations apply DB --remote --config wrangler.json && wrangler deploy --config wrangler.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "^4.11.9",
    "jose": "6.2.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@void/react": "1.5.0",
    "oxc-transform-react": "^0.149.0",
    "secretlint": "13.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0",
    "void": "1.5.0",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@cloudflare/config": {
      "zod": "$zod"
    },
    "esbuild": "^0.28.2",
    "undici": "^7.30.1",
    "vite": "$vite"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "日程・回答・所有者情報を保存する専用データベース。新規作成する名前を指定してください。"
      }
    }
  }
}
